# Environment configuration for Kitchen 3D Studio
# Firebase AI Logic (Gemini API) uses Firebase App Check for zero-trust attestation.
# Google Sign-In web client ID (OAuth client from Firebase console:
# Project settings -> General -> Your apps -> Web client ID).
# The repo has no google-services.json, so the app reads this BuildConfig
# value instead of R.string.default_web_client_id. Leave it empty to build
# without Google Sign-In (sign-in is skipped gracefully when blank).
DEFAULT_WEB_CLIENT_ID=
